# Copy to .env (gitignored) for `yarn dispute` / `yarn apply`. Variables already set in the shell take precedence.
# The MCP review server for agents does NOT read this file's PRIVATE_KEY; give it settings in .oo-dispute/mcp.env.

CHAIN_ID=137

# RPC. Prefer several providers, tried in order (it must allow eth_getLogs over ~3,500 blocks, or lower
# MAX_BLOCK_LOOK_BACK below). NODE_URLS_137 wins over NODE_URL_137 when both are set.
NODE_URLS_137=["https://polygon-rpc-1.example","https://polygon-rpc-2.example"]
# NODE_URL_137=https://polygon-rpc.example

# Disputer key: a dedicated hot wallet holding only the bonds it may post (USDC.e) and POL for gas.
# Safer than this file: `read -rs PRIVATE_KEY && export PRIVATE_KEY` in the terminal that runs apply / dispute.
PRIVATE_KEY=

# DisputeBatcher for the permissionless OOv2 (UMAprotocol/mcp-otb#2826). Not deployed on Polygon yet: leave empty and
# OOv2 disputes go one per transaction; Managed OOv2 disputes are batched through its own multicall either way.
DISPUTE_BATCHER_ADDRESS=

# Optional (defaults shown):
# BLOCK_LOOKBACK_PERIOD=43200    # blocks scanned for proposals on a fresh start (~24 h on Polygon)
# MAX_BLOCK_LOOK_BACK=3499       # blocks per eth_getLogs call; lower it if the RPC rejects the range
# MIN_PRIORITY_FEE_GWEI=30       # tip floor before the --multiplier
# GAS_PER_DISPUTE=500000         # gas budgeted per dispute in a batch
# RPC_CONCURRENCY=10
